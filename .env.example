# Copy to .env and fill in. Never commit .env — it holds live credentials.
# Values shown after "=" are the DEFAULTS the code uses when the key is absent.

# ─── Required ──────────────────────────────────────────────────────────────────
API_KEY=
API_SECRET=
# Total USD to spend per run, split by CRYPTO_ALLOCATION_STRING weights.
DAILY_USD=10
# Weights, not percentages. Coins must have a spot pair against STABLECOIN
# (or at least against USDT for market data — see resolve_symbol).
CRYPTO_ALLOCATION_STRING=ETH:0.5,SOL:0.4
# Quote coin. First value is used.
STABLECOIN=USDC

# ─── Safety (defaults are deliberately conservative) ───────────────────────────
# true = simulate, place NO real orders. The bot ships safe; you opt into
# trading explicitly, either here or with --live.
DRY_RUN=true
# Point at Bybit testnet instead of production.
TESTNET=false
# Absolute USD ceiling per run, whatever the multipliers say. Set this so it
# actually BINDS: the default (DAILY_USD x 3) equals the sum of the per-coin
# caps, so it can never fire. With DAILY_USD=10 and weights summing to 1, the
# legitimate maximum is $20 — a cap of $22 catches a typo without blocking a
# normal boosted day.
# MAX_SPEND_PER_RUN=22
# Cap on the PRODUCT of the stacked buy multipliers.
MAX_COMBINED_MULTIPLIER=3.0
# Minimum residual worth routing through Convert after a partial spot fill.
MIN_CONVERT_USD=1.0

# ─── Optional: Telegram alerts ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Optional: Supabase trade ledger ───────────────────────────────────────────
# Without these, trades execute but are NOT recorded, and the idempotency gate
# falls back to the local log/last_run.json only.
TABLE_URL=
TABLE_PASSWORD=

# ─── Strategy ──────────────────────────────────────────────────────────────────
# Fear & Greed + Bollinger buy multiplier.
USE_MARKET_BOOST=true
DCA_BOOST_MULTIPLIER=2.0
# Buy-side rebalancing toward target weights.
REBALANCE_THRESHOLD=5
REBALANCE_MULTIPLIER=1.5
# Circuit breaker: skip a coin trading this far below its N-hour high.
FLASH_CRASH_PCT=25
FLASH_CRASH_HOURS=1
# Skip buys above these prices.
MAX_PRICE_STRING=BTC:100000,ETH:5000

# ─── Execution ─────────────────────────────────────────────────────────────────
# Try a Post-Only maker order before falling back to Convert (cheaper, slower).
USE_SPOT_ORDERS=false
SPOT_ORDER_TIMEOUT=180

# ─── Earn / staking ────────────────────────────────────────────────────────────
# coin:category:liquid_buffer_qty. OnChain products can have an unbonding
# period — staked funds are not immediately sellable.
STAKEABLE_COINS=SOL:OnChain:0.2,ETH:FlexibleSaving:0.001
# Days of spend to keep liquid before sweeping surplus into Earn.
USDT_BUFFER_DAYS=3

# ─── Reporting ─────────────────────────────────────────────────────────────────
PNL_FROM_DATE=2025-11-01
